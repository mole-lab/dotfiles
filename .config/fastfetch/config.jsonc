{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Logo lives outside the public repo (~/Pictures); only the path is stored here.
  "logo": {
    "type": "kitty",
    "source": "$HOME/Pictures/G1-tomie-hair-hands.png",
    "width": 24,
    "height": 12,
    "preserveAspectRatio": true,
    // 21 info lines - 12 logo lines = 9 -> 4 above (vertically centered)
    "padding": {
      "top": 4,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  // No title (user@host), local IP or public IP: keeps screenshots safe to share.
  "modules": [
    // --- Hardware ---
    { "type": "custom", "format": "┌──────────────── Hardware ────────────────┐" },
    { "type": "cpu", "key": " ├─  ", "keyColor": "38;5;240" },
    { "type": "gpu", "key": " ├─ 󰍛 ", "keyColor": "38;5;240" },
    { "type": "memory", "key": " ├─ 󰘚 ", "keyColor": "38;5;240" },
    { "type": "disk", "key": " ├─ 󰋊 ", "keyColor": "38;5;240", "folders": "/" },
    { "type": "battery", "key": " └─ 󰁹 ", "keyColor": "38;5;240" },
    { "type": "custom", "format": "└──────────────────────────────────────────┘" },

    // --- Software ---
    { "type": "custom", "format": "┌──────────────── Software ────────────────┐" },
    { "type": "os", "key": " ├─ 󰣇 ", "keyColor": "38;5;240" },
    { "type": "kernel", "key": " ├─  ", "keyColor": "38;5;240" },
    { "type": "packages", "key": " ├─ 󰏖 ", "keyColor": "38;5;240" },
    { "type": "shell", "key": " ├─  ", "keyColor": "38;5;240" },
    { "type": "uptime", "key": " └─ 󰅐 ", "keyColor": "38;5;240" },
    { "type": "custom", "format": "└──────────────────────────────────────────┘" },

    // --- Desktop ---
    { "type": "custom", "format": "┌──────────────── Desktop ─────────────────┐" },
    { "type": "wm", "key": " ├─ 󰨇 ", "keyColor": "38;5;240" },
    { "type": "terminal", "key": " ├─  ", "keyColor": "38;5;240" },
    { "type": "theme", "key": " ├─ 󰉼 ", "keyColor": "38;5;240" },
    { "type": "icons", "key": " ├─ 󰀻 ", "keyColor": "38;5;240" },
    { "type": "font", "key": " └─ 󰛖 ", "keyColor": "38;5;240" },
    { "type": "custom", "format": "└──────────────────────────────────────────┘" }
  ]
}
